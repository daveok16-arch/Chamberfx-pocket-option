# GROQ_API_KEY: Required for Groq API market analysis and fast model fallback.
# Obtain your key from the Groq console (https://console.groq.com/)
GROQ_API_KEY="your_groq_api_key_here"

# GROK_API_KEY: Required for xAI Grok API market analysis and signal reasoning.
# Obtain your key from the xAI console (https://console.xai.com/)
# Set this variable in your local environment or the secrets management interface.
# Never expose this API key to the frontend or commit it to Git.
GROK_API_KEY="your_grok_api_key_here"

# GEMINI_API_KEY: Required for Google Gemini fallback and comparative market reasoning.
# Obtain your key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_google_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: The port the persistent Node.js server listens on (Render automatically injects this variable).
PORT=3000

# DEBUG_WEBSOCKET: Set to "true" to enable verbose logging of incoming WebSocket messages and packets.
DEBUG_WEBSOCKET=false

