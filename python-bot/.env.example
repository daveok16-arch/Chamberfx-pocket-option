# ===========================================
# CHAMBERFX Trading Bot Configuration
# Copy this file to .env and fill in your values
# ===========================================

# REQUIRED: Telegram Bot Token from @BotFather
# Get it by messaging @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# REQUIRED: Your Telegram Chat ID
# Get it by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# ===========================================
# TRADING CONFIGURATION
# ===========================================

# Minimum signal confidence (0-100)
# Higher = fewer signals, potentially more accurate
MIN_CONFIDENCE=70

# Tick threshold for volume bars (150-200 recommended)
TICK_THRESHOLD=175

# Cooldown between signals per asset (seconds)
SIGNAL_COOLDOWN=60

# Assets to Trade (OTC pairs)
ASSETS=EURUSD_otc,GBPUSD_otc,USDJPY_otc,XAUUSD_otc,AUDUSD_otc,USDCAD_otc,NZDUSD_otc,EURGBP_otc,BTCUSD_otc,ETHUSD_otc

# ===========================================
# LOGGING
# ===========================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
