# Candle period for the capture base (seconds): 60 | 180 | 300 (default 60)
PERIOD=60

# Real-money trading is DISABLED (PAPER mode) by default — the bot never sends
# a real order. Set to 1 ONLY to arm live execution (and confirm the
# authenticated session is a NON-demo account; the executor refuses demo
# sessions even so). Leave unset or 0 to stay in safe PAPER mode.
# ALLOW_LIVE=0
